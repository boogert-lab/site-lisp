#% text_encoding = iso8859_1

_package sw

!global_auto_declare?! << _true
$

_block
	# SHORTCUTS IN A FORM THAT CAN BE PROCESSED BY SETVARS()
	# Definitions are stored in the following globals:
	# !sv! is the proc that does compile the defintion
	# this proc is executed when this file is loaded
	
	_global !gs!,!gd!,!gdb!,!gprocs!,!dmethods!
	
	# GLOBAL SHORTCUT DEFINITIONS
	!gs! << {#objects
		 :g,:gis_program_manager,
		 :sp,:smallworld_product,
		 :smm,:sw_module_manager,
		 :mh,:message_handler,
		 #procs
		 :p,:print,
		 :w,:write,
		 :dp,:debug_print,
		 :pa,:print_ancestry,
		 :ph,:print_hierarchy,
		 :ap,:apropos}
	
	# DRAWING GLOBALS
	!gd! << {:red,"colour.new_rgb(1,0,0)",
		 :green,"colour.new_rgb(0,1,0)",
		 :blue,"colour.new_rgb(0,0,1)",
		 :white,"colour.new_rgb(1,1,1)",
		 :black,"colour.new_rgb(0,0,0)",
		 :red_line,"line_style.new(colour.new_rgb(1,0,0),3)",
		 :green_line,"line_style.new(colour.new_rgb(0,1,0),3)",
		 :blue_line,"line_style.new(colour.new_rgb(0,0,1),3)"}

	# DATABASE SHORTCUTS
	!gdb! << {:gv,"gis_program_manager.cached_dataset(:gis)",
		 :cv,"gis_program_manager.cached_dataset(:case)",
		 :acv,"gis_program_manager.ace_view",
		 :sv,"gis_program_manager.style_view",
		 :auv,"gis_program_manager.authorisation_view",
		 :mv,"message_handler.view",
		 # WO
		 :ws,"gis_program_manager.cached_dataset(:water_supply)",
		 :dr,"gis_program_manager.cached_dataset(:drainage)",
		 :csc,"gis_program_manager.cached_dataset(:cs_config)",
		 # EO
		 :ev,"gis_program_manager.cached_dataset(:electric)"}


	# Just to be able to show which procs are defined. Global is
	# populated on defintion with key and proc as value
	!gprocs! << property_list.new()

	# A list of defined methods
	!dmethods! << set.new()
	
_endblock 
$

##
## ====================================================
## The setvars proc
## ====================================================
##

_pragma(classify_level=debug, usage={internal}, topic={shortcuts})
_global !sv! << !gprocs![:!sv!] << 
##
## Process the globals defined in !gs!, !gd!, and
## !gdb! if ds_environment is initialised
## All code is first written to a temp_file_name.
## Methods are defined and evaluated from this file
##
_proc @setvars(_optional verbose?)

	_local l_verbose? << verbose? _is _true 
	t << system.temp_file_name("handig")
	e << external_text_output_stream.new(t)

	# Write global shortcuts defintions
	_for i _over range(1,!gs!.size,2)
	_loop
		str << write_string("_global ",!gs![i],"<<!current_package![:",!gs![i+1],"]")
		e.write(str,newline_char)
		_if l_verbose? _then write(str) _endif
	_endloop

	# Write drawing stuff globals
	_for i _over range(1,!gd!.size,2)
	_loop str << write_string("_global ",!gd![i],"<<",!gd![i+1])
	      _if l_verbose? _then write(str) _endif
	      e.write(str,newline_char)
	_endloop

	_if l_verbose? _is _true
	_then
		# Just write the procs that are defined
		_for i,j _over !gprocs!.fast_keys_and_elements()
		_loop write(i,space_char,j)
		_endloop
		# Just write out the methods that are defined
		_for i _over !dmethods!.fast_elements()
		_loop write("_method ",i)
		_endloop
	_endif

	# Global database shortcuts
	_if ds_environment.c_is_initialised?
	_then 
		_for i _over range(1,!gdb!.size,2)
		_loop str << write_string("_global ",!gdb![i],"<<",!gdb![i+1])
		      e.write(str,newline_char)
		      _if l_verbose? _then write(str) _endif 
		_endloop
	_endif
	
	e.close()
	load_file(t) 

	# Execute any global proc with 'setvars' in its name
	!losv!( l_verbose? )
	
	write("Set Vars DONE "," - use !sv!(_optional verbose?) to set, !lv!() to list shortcuts")
	>> _true 
_endproc
$

_pragma(classify_level=debug, usage={internal}, topic={shortcuts})
_global !losv! << !gprocs![:!losv!] << 
##
## Loads any proc in a global with in its name 'setvars'
##
_proc @load_other_setvars(_optional verbose?)
	_local ios << internal_text_output_stream.new()
	_dynamic !output! << ios
	apropos(:setvars)
	_local l_strings << ios.string.split_by(newline_char)
	!output! << !terminal!
	write("Found ",l_strings.size," globals with setvars in name:")
	_for i_s _over l_strings.fast_elements()
	_loop 
		_local l_ps << _allresults i_s.split_by(space_char)[1]
		_local l_proc << !current_package![l_ps[1].as_symbol()]
		_if l_proc.class_name _is :procedure
		_then
			_if verbose? _is _true
			_then write(newline_char,"Invoking ",l_proc," from ",l_proc.source_file)
			_endif
			l_proc.invoke()
		_endif
	_endloop
_endproc
$

_pragma(classify_level=debug,topic={shortcuts})
## Loads a session specific handig.magik from the home
## directory if present
_global !lsh! << !gprocs![:!lsh!] << 
_proc @load_session_handig()

	_try _with cond

		_local l_sn << smallworld_product.session_string_debug
		_local l_home << system.home
		_local l_s << directory_channel.new(l_home,"*.magik")
		_loop
			_if (l_name << l_s.get_full()) _is _unset 
			_then _leave 
			_endif
			_if l_name.index_of_seq(l_sn) _isnt _unset 
			_then #DEBUG write("Found ",l_name)
			      load_file(l_name)
			_endif
		_endloop
		
	_when error
		write("Error loading session handig - ",cond.report_contents_string)
	_endtry
_endproc
$

_pragma(classify_level=debug, usage={internal}, topic={shortcuts})
_global !lv! << !gprocs![:!lv!] << 
##
## List shortcuts and procs from !gs!, !gd!, !gdb!, !gprocs!
## and !dmethods!
##
_proc @listvars()

	# List global shortcuts defintions
	_for i _over range(1,!gs!.size,2)
	_loop
		str << write_string("_global ",!gs![i],"<<!current_package![:",!gs![i+1],"]")
		write(str)
	_endloop

	# List drawing stuff globals
	_for i _over range(1,!gd!.size,2)
	_loop
		str << write_string("_global ",!gd![i],"<<",!gd![i+1])
		write(str)
	_endloop

	# Just write the procs that are defined
	_for i,j _over !gprocs!.fast_keys_and_elements()
	_loop write("_global ",i," :",j)
	_endloop

	# Just write out the methods that are defined
	_for i _over !dmethods!.fast_elements()
	_loop write("_method ",i)
	_endloop

	# Global database shortcuts
	_if ds_environment.c_is_initialised?
	_then 
		_for i _over range(1,!gdb!.size,2)
		_loop write("_global ",!gdb![i],"<<",!gdb![i+1])
		_endloop
	_endif
_endproc
$

##
## ====================================================
## METHODS ON OBJECT
## ====================================================
##

!dmethods!.add("object.ap()")
$
_pragma(classify_level=debug,topic={shortcuts})
_method object.ap(_gather args)
	## Does self.apropos
	_return _self.apropos(_scatter args)
_endmethod
$

!dmethods!.add("object.p")
$
_pragma(classify_level=debug,topic={shortcuts})
_method object.p
	## Does print self
	print(_self)
	_return _self 
_endmethod
$

!dmethods!.add("object.dp")
$
_pragma(classify_level=debug,topic={shortcuts})
_method object.dp
	## Does debug print self
	debug_print(_self)
	_return _self 
_endmethod
$

!dmethods!.add("object.ph")
$
_pragma(classify_level=debug,topic={shortcuts})
_method object.ph
	## print_hierarchy of self 
	print_hierarchy(_self)
	_return _self 
_endmethod
$

!dmethods!.add("object.pa")
$
_pragma(classify_level=debug,topic={shortcuts})
_method object.pa
	## print_ancestry of _self
	print_ancestry(_self)
	_return _self 
_endmethod
$

!dmethods!.add("object.ae")
$
_pragma(classify_level=debug,topic={shortcuts})
_method object.ae
	## If self responds to an_element(), return it
	_if _self.responds_to?(:|an_element()|)
	_then 
		_return _self.an_element()
	_else
		write("Class ",_self.class_name," does not have the method an_element()!")
	_endif 
_endmethod
$


##
## ====================================================
## Very basic procs
## ====================================================
##

_pragma(classify_level=debug,topic={shortcuts})
##
_global writer << !gprocs![:writer] << 
_proc @performs_iter_and_writes_elements(a_col, _optional an_iter, a_method, _gather args)
	l_iter << an_iter.default(:|elements()|)
	_for l _over a_col.perform_iter(l_iter, _scatter args)
	_loop
		_if a_method _isnt _unset _andif
				      l.responds_to?(a_method)
		_then
			write(l," || ",l.perform(a_method))
		_else
			write(l)
		_endif
	_endloop
_endproc
$

_pragma(classify_level=debug,topic={shortcuts})
##
_global priter << !gprocs![:priter] << 
_proc @iters_and_prints_elements(a_col)
	_for l _over a_col.fast_elements()
	_loop
		print(l)
	_endloop
_endproc
$

_pragma(classify_level=debug,topic={shortcuts})
##
_global wrel << !gprocs![:wrel] << 
_proc @loops_over_elements_and_writes_them(a_col, _optional a_method)
	_for l _over a_col.elements()
	_loop
		_if a_method _isnt _unset _andif
		    l.responds_to?(a_method)
		_then
			write(l," || ",l.perform(a_method))
		_else
			write(l)
		_endif
	_endloop
_endproc
$

_pragma(classify_level=debug,topic={shortcuts})
##
_global wrkel << !gprocs![:wrkel] << 
_proc @loops_over_keys_and_elements_and_writes_them(a_col, _optional a_method)

	_if a_col.method(:|fast_keys_and_elements()|) _is _unset
	_then
		write("No keys available:")
		wrel(a_col, a_method)
	_else
		_for k,l _over a_col.fast_keys_and_elements()
		_loop
			_if a_method _isnt _unset _andif
			    l.responds_to?(a_method)
			_then
				write(k, "    ", l," || ",l.perform(a_method))
			_else
				write(k, "    ", l)
			_endif
		_endloop
	_endif
_endproc
$

_pragma(classify_level=debug,topic={shortcuts})
##
_global prel << !gprocs![:prel] << 
_proc @loops_over_elements_and_prints_them(a_col)
	_for l _over a_col.elements()
	_loop
		write("----")
		print(l)
	_endloop
_endproc
$

